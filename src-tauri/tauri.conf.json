{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rove",
  "version": "0.1.0",
  "identifier": "com.rove.explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rove", "width": 1240, "height": 800, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}